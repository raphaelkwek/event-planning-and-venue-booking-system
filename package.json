{
  "name": "connectsphere",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/services/*",
    "backend/packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names core,notif,reg,web,worker --prefix-colors blue,magenta,cyan,green,yellow \"npm run dev -w @connectsphere/planning-core\" \"npm run dev -w @connectsphere/notification\" \"npm run dev -w @connectsphere/registration\" \"npm run dev -w @connectsphere/web\" \"npm run worker -w @connectsphere/planning-core\"",
    "kafka:check": "tsx backend/scripts/kafka-check.ts",
    "schemas:generate": "tsx backend/scripts/schema-compat.ts generate",
    "schemas:check": "tsx backend/scripts/schema-compat.ts check",
    "schemas:compat": "tsx backend/scripts/schema-compat.ts compat",
    "temporal:check": "node --import tsx backend/scripts/temporal-check.ts",
    "migrate": "tsx backend/scripts/migrate.ts",
    "migrate:all": "tsx backend/scripts/migrate.ts all --seed",
    "migrate:identity": "tsx backend/scripts/migrate.ts identity --seed",
    "migrate:event": "tsx backend/scripts/migrate.ts event",
    "migrate:notification": "tsx backend/scripts/migrate.ts notification",
    "migrate:registration": "tsx backend/scripts/migrate.ts registration",
    "event-store:verify": "tsx backend/services/planning-core/scripts/verify-event-store.ts",
    "seed:auth": "tsx backend/services/planning-core/migrations/identity/seed/seed-auth-users.ts",
    "lead:create": "node deploy/scripts/create-lead.mjs",
    "deploy:space": "node deploy/space/deploy-space.mjs",
    "test-cases:reset": "tsx tests/fixtures/reset-test-data.ts",
    "test-cases:run": "playwright test --config tests/playwright.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "jobs:schedule-hold-expiries": "tsx --env-file=.env backend/services/planning-core/src/temporal/runScheduleHoldExpiries.ts",
    "jobs:complete-events": "tsx --env-file=.env backend/services/planning-core/src/modules/event/jobs/runCompleteEvents.ts",
    "jobs:expire-holds": "tsx --env-file=.env backend/services/planning-core/src/modules/venue/jobs/runExpireHolds.ts",
    "changelog": "tsx documentation/scripts/changelog.ts",
    "confluence:digest": "tsx documentation/scripts/confluence-digest.ts",
    "submission:build": "tsx documentation/scripts/build-submission.ts",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "tsx --test documentation/scripts/confluence-digest.test.ts documentation/scripts/check-error-codes.test.ts documentation/scripts/traceability-matrix.test.ts documentation/scripts/dora.test.ts documentation/scripts/check-observability.test.ts documentation/scripts/check-docs.test.ts tests/e2e/support/fake-supabase-auth.test.ts .github/scripts/markdown-cell.test.mjs deploy/release/release.test.mjs deploy/scripts/create-lead.test.mjs deploy/space/deploy-space.test.mjs",
    "test:unit": "npm run test:unit --workspaces --if-present && npm run test:scripts && npm run test:harness",
    "test:mutation": "npm run test:mutation --workspaces --if-present",
    "policies:test": "tsx backend/scripts/cerbos.ts compile policies",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json && npm run typecheck:harness",
    "lint:boundaries": "npm run lint:boundaries -w @connectsphere/planning-core",
    "lint:api": "redocly lint documentation/api/planning-core.openapi.yaml documentation/api/notification.openapi.yaml documentation/api/registration.openapi.yaml && tsx documentation/scripts/check-error-codes.ts",
    "lint": "eslint frontend backend tests load chaos documentation/scripts eslint.config.js && npm run lint:boundaries && npm run lint:api",
    "typecheck:harness": "tsc -p load/tsconfig.json --noEmit && tsc -p chaos/tsconfig.json --noEmit",
    "test:harness": "vitest run --config load/vitest.config.ts",
    "load": "tsx load/support/run.ts",
    "chaos": "vitest run --config chaos/vitest.config.ts"
  },
  "dependencies": {
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.57.0",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/vitest-runner": "8.7.1",
    "concurrently": "^9.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jose": "^5.6.3",
    "kafkajs": "^2.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
