{
  "name": "connectsphere",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/services/*",
    "backend/packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names core,notif,web --prefix-colors blue,magenta,green \"npm run dev -w @connectsphere/planning-core\" \"npm run dev -w @connectsphere/notification\" \"npm run dev -w @connectsphere/web\"",
    "kafka:check": "tsx backend/scripts/kafka-check.ts",
    "migrate": "tsx backend/scripts/migrate.ts",
    "migrate:all": "tsx backend/scripts/migrate.ts all --seed",
    "migrate:identity": "tsx backend/scripts/migrate.ts identity --seed",
    "migrate:event": "tsx backend/scripts/migrate.ts event",
    "migrate:notification": "tsx backend/scripts/migrate.ts notification",
    "seed:auth": "tsx backend/services/planning-core/migrations/identity/seed/seed-auth-users.ts",
    "test-cases:reset": "tsx tests/fixtures/reset-test-data.ts",
    "test-cases:run": "playwright test --config tests/playwright.config.ts",
    "confluence:digest": "tsx documentation/scripts/confluence-digest.ts",
    "submission:build": "tsx documentation/scripts/build-submission.ts",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "tsx --test documentation/scripts/confluence-digest.test.ts",
    "test:unit": "npm run test:unit --workspaces --if-present && npm run test:scripts",
    "policies:test": "tsx backend/scripts/cerbos.ts compile policies",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:boundaries": "npm run lint:boundaries -w @connectsphere/planning-core",
    "lint:api": "redocly lint documentation/api/planning-core.openapi.yaml documentation/api/notification.openapi.yaml",
    "lint": "eslint frontend backend tests documentation/scripts eslint.config.js && npm run lint:boundaries && npm run lint:api"
  },
  "dependencies": {
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.57.0",
    "concurrently": "^9.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "kafkajs": "^2.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  }
}
