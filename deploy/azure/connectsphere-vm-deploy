#!/usr/bin/env bash
# ADR-0016 amendment (Azure): the deploy gate on the VM, the only thing the Release workflow can run.
#
# setup-deploy-user.sh installs it as /usr/local/bin/connectsphere-vm-deploy and gives each
# environment's deploy key a forced command in ~cs-deploy/.ssh/authorized_keys:
#
#   command="/usr/local/bin/connectsphere-vm-deploy staging",restrict ssh-ed25519 AAAA...
#
# so the staging key can only deploy or check staging: no shell, no forwarding, no other environment.
#
#   deploy <image>   <image> is ghcr.io/<owner>/connectsphere-space@sha256:<digest>. stdin holds the
#                    container's settings as KEY=value lines (only the keys below), and may hold
#                    GHCR_USER and GHCR_TOKEN, which are used for the pull and never stored. Writes the
#                    environment's env file (mode 660, group connectsphere), pulls the image, replaces
#                    the container (migrations run as it starts), and waits until every service is
#                    ready. Prints key names and states, never a value.
#   health           Each service's /readyz, Cerbos, and the container's processes.
#
# Run by hand: sudo -u cs-deploy connectsphere-vm-deploy staging health
set -euo pipefail

ENVIRONMENT="${1:-}"
case "$ENVIRONMENT" in
  staging) PORT=7861 ;;
  production) PORT=7862 ;;
  *) echo "connectsphere-vm-deploy: the environment must be staging or production" >&2; exit 2 ;;
esac
CONTAINER="connectsphere-${ENVIRONMENT}"
ENV_FILE="/etc/connectsphere/${ENVIRONMENT}.env"
SETTINGS=(DATABASE_URL MIGRATE_DATABASE_URL SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_SERVICE_ROLE_KEY CORS_ALLOWED_ORIGINS REDPANDA_MEMORY)
REQUIRED=(DATABASE_URL MIGRATE_DATABASE_URL SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_SERVICE_ROLE_KEY CORS_ALLOWED_ORIGINS)

refuse() { echo "connectsphere-vm-deploy: refused: $*" >&2; exit 3; }
member() { local x; for x in "${@:2}"; do [ "$x" = "$1" ] && return 0; done; return 1; }

if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  read -r -a WORDS <<< "$SSH_ORIGINAL_COMMAND"
else
  WORDS=("${@:2}")
fi
VERB="${WORDS[0]:-}"

wait_ready() { # every service ready with the database and Kafka, and Cerbos serving
  local port body deadline=$((SECONDS + 600))
  until curl -fsS "http://127.0.0.1:${PORT}/healthz" > /dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] || { echo "connectsphere-vm-deploy: ${CONTAINER} never answered /healthz" >&2; docker ps -a --filter "name=^${CONTAINER}$" --format '{{.Names}} {{.Status}}' >&2; return 1; }
    sleep 5
  done
  for port in 8090 8091 8092; do
    until body="$(docker exec "$CONTAINER" curl -fsS "http://127.0.0.1:${port}/readyz" 2> /dev/null)" \
      && grep -q '"database":"ok"' <<< "$body" && grep -q '"kafka":"reachable"' <<< "$body"; do
      [ "$SECONDS" -lt "$deadline" ] || { echo "connectsphere-vm-deploy: the service on ${port} is not ready: ${body:-no answer}" >&2; return 1; }
      sleep 5
    done
    echo ":${port}/readyz ${body}"
  done
  body="$(docker exec "$CONTAINER" curl -fsS http://127.0.0.1:3592/_cerbos/health)"
  grep -q SERVING <<< "$body" || { echo "connectsphere-vm-deploy: Cerbos is not serving" >&2; return 1; }
  echo "cerbos ${body}"
}

deploy() {
  [ "${#WORDS[@]}" -eq 2 ] || refuse "deploy takes one argument, the image by digest"
  local image="${WORDS[1]}" line key dir config count=0 ghcr_user="" ghcr_token=""
  [[ "$image" =~ ^ghcr\.io/[a-z0-9._-]+/connectsphere-space@sha256:[0-9a-f]{64}$ ]] || refuse "the image must be ghcr.io/<owner>/connectsphere-space@sha256:<digest>"
  dir="$(mktemp -d)"
  chmod 700 "$dir"
  # shellcheck disable=SC2064 # expand now: the directory goes however the gate exits.
  trap "rm -rf '$dir'" EXIT
  : > "$dir/env"
  declare -A seen=()
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [ -z "$line" ] && continue
    [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || refuse "a line is not KEY=value"
    key="${BASH_REMATCH[1]}"
    case "$key" in
      GHCR_USER) ghcr_user="${BASH_REMATCH[2]}"; continue ;;
      GHCR_TOKEN) ghcr_token="${BASH_REMATCH[2]}"; continue ;;
    esac
    member "$key" "${SETTINGS[@]}" || refuse "${key} is not a setting this gate accepts"
    [ -z "${seen[$key]:-}" ] || refuse "${key} is given twice"
    seen[$key]=1
    printf '%s\n' "$line" >> "$dir/env"
    count=$((count + 1))
  done
  for key in "${REQUIRED[@]}"; do [ -n "${seen[$key]:-}" ] || refuse "${key} is missing"; done
  (umask 007 && cp "$dir/env" "$ENV_FILE")
  chmod 660 "$ENV_FILE"
  echo "${ENV_FILE}: ${count} settings (${!seen[*]})"

  config="$dir/docker"
  mkdir -p "$config"
  if [ -n "$ghcr_token" ]; then
    printf '%s' "$ghcr_token" | DOCKER_CONFIG="$config" docker login ghcr.io -u "${ghcr_user:-deploy}" --password-stdin > /dev/null
  fi
  DOCKER_CONFIG="$config" docker pull -q "$image" > /dev/null
  echo "pulled ${image}"
  docker rm -f "$CONTAINER" > /dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" --restart unless-stopped --env-file "$ENV_FILE" -p "127.0.0.1:${PORT}:7860" "$image" > /dev/null
  echo "started ${CONTAINER}; migrations run as it starts"
  wait_ready
  echo "${CONTAINER} is ready on ${image}"
}

health() {
  [ "${#WORDS[@]}" -eq 1 ] || refuse "health takes no arguments"
  docker ps --filter "name=^${CONTAINER}$" --format '{{.Names}} {{.Image}} {{.Status}}'
  wait_ready
  docker exec "$CONTAINER" supervisorctl -c /app/deploy/space/supervisord.conf status
}

case "$VERB" in
  deploy) deploy ;;
  health) health ;;
  *) refuse "unknown request; the gate accepts deploy <image> and health" ;;
esac
