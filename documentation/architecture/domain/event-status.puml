@startuml event-status
' Generated by documentation/scripts/generate-state-machines.ts from backend/services/planning-core/src/modules/event/domain/statusMachine.ts. Do not edit by hand.
title Event status machine (F1): every transition is a row of TRANSITIONS, applied only by transitionEvent
hide empty description
skinparam shadowing false

state "Draft" as DRAFT
state "Submitted" as SUBMITTED
state "Under Review" as UNDER_REVIEW
state "Awaiting Clarification" as AWAITING_CLARIFICATION
state "Approved" as APPROVED
state "Rejected" as REJECTED
state "Safety Review" as SAFETY_REVIEW
state "Planning" as PLANNING
state "Confirmed" as CONFIRMED
state "Completed" as COMPLETED
state "Cancelled" as CANCELLED

[*] --> DRAFT : a request is started
DRAFT --> SUBMITTED : SUBMIT
SUBMITTED --> UNDER_REVIEW : OPEN_FOR_REVIEW
UNDER_REVIEW --> AWAITING_CLARIFICATION : REQUEST_CLARIFICATION
AWAITING_CLARIFICATION --> UNDER_REVIEW : RESPOND_TO_CLARIFICATION
UNDER_REVIEW --> APPROVED : APPROVE
AWAITING_CLARIFICATION --> APPROVED : APPROVE
UNDER_REVIEW --> REJECTED : REJECT
AWAITING_CLARIFICATION --> REJECTED : REJECT
APPROVED --> SAFETY_REVIEW : CONFIRM_ARRANGEMENTS
PLANNING --> SAFETY_REVIEW : CONFIRM_ARRANGEMENTS
SAFETY_REVIEW --> SAFETY_REVIEW : APPROVE_SAFETY
SAFETY_REVIEW --> PLANNING : REQUEST_SAFETY_CHANGES / REJECT_SAFETY_ARRANGEMENT
SAFETY_REVIEW --> CONFIRMED : MARK_CONFIRMED
CONFIRMED --> PLANNING : VENUE_BLOCKED / RECONSIDER_AFTER_CHANGE
CONFIRMED --> COMPLETED : COMPLETE
DRAFT --> CANCELLED : CANCEL
SUBMITTED --> CANCELLED : CANCEL
UNDER_REVIEW --> CANCELLED : CANCEL
AWAITING_CLARIFICATION --> CANCELLED : CANCEL
APPROVED --> CANCELLED : CANCEL
PLANNING --> CANCELLED : CANCEL
SAFETY_REVIEW --> CANCELLED : CANCEL
CONFIRMED --> CANCELLED : CANCEL
CANCELLED --> [*]
COMPLETED --> [*]
REJECTED --> [*]

@enduml
