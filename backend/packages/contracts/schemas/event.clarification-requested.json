{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "clarificationId": {
      "format": "uuid",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "ownerId": {
      "format": "uuid",
      "type": "string"
    },
    "requestedAt": {
      "format": "date-time",
      "type": "string"
    },
    "requestedBy": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "clarificationId",
    "eventId",
    "eventName",
    "eventReference",
    "ownerId",
    "requestedAt",
    "requestedBy"
  ],
  "type": "object"
}
