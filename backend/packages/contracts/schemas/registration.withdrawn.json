{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "attendeeId": {
      "format": "uuid",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "registeredAt": {
      "format": "date-time",
      "type": "string"
    },
    "registrationId": {
      "format": "uuid",
      "type": "string"
    },
    "registrationReference": {
      "pattern": "^REG-\\d{6}$",
      "type": "string"
    },
    "withdrawnAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "attendeeId",
    "eventId",
    "eventName",
    "eventReference",
    "registeredAt",
    "registrationId",
    "registrationReference",
    "withdrawnAt"
  ],
  "type": "object"
}
