{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "coordinatorId": {
      "format": "uuid",
      "type": "string"
    },
    "endsAt": {
      "format": "date-time",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "holdId": {
      "format": "uuid",
      "type": "string"
    },
    "holdReference": {
      "pattern": "^HLD-\\d{6}$",
      "type": "string"
    },
    "startsAt": {
      "format": "date-time",
      "type": "string"
    },
    "venueId": {
      "format": "uuid",
      "type": "string"
    },
    "venueName": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "coordinatorId",
    "endsAt",
    "eventId",
    "eventName",
    "eventReference",
    "expiresAt",
    "holdId",
    "holdReference",
    "startsAt",
    "venueId",
    "venueName"
  ],
  "type": "object"
}
