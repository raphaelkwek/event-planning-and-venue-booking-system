{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assignedCoordinatorId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "bookings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "reference": {
            "minLength": 1,
            "type": "string"
          },
          "staffIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "venueName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "endsAt",
          "reference",
          "staffIds",
          "startsAt",
          "venueName"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cancelledAt": {
      "format": "date-time",
      "type": "string"
    },
    "cancelledBy": {
      "format": "uuid",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "holds": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "reference": {
            "minLength": 1,
            "type": "string"
          },
          "staffIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "venueId": {
            "format": "uuid",
            "type": "string"
          },
          "venueName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "endsAt",
          "reference",
          "staffIds",
          "startsAt",
          "venueId",
          "venueName"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ownerId": {
      "format": "uuid",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "requests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "reference": {
            "minLength": 1,
            "type": "string"
          },
          "staffIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "venueId": {
            "format": "uuid",
            "type": "string"
          },
          "venueName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "endsAt",
          "reference",
          "staffIds",
          "startsAt",
          "venueId",
          "venueName"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "reservations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "equipmentTypeName": {
            "minLength": 1,
            "type": "string"
          },
          "reservedBy": {
            "format": "uuid",
            "type": "string"
          },
          "reservedQuantity": {
            "exclusiveMinimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "equipmentTypeName",
          "reservedBy",
          "reservedQuantity"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "assignedCoordinatorId",
    "bookings",
    "cancelledAt",
    "cancelledBy",
    "eventId",
    "eventName",
    "eventReference",
    "ownerId",
    "reason",
    "reservations"
  ],
  "type": "object"
}
