{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "changedBy": {
      "format": "uuid",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "holdId": {
      "format": "uuid",
      "type": "string"
    },
    "holdReference": {
      "pattern": "^HLD-\\d{6}$",
      "type": "string"
    },
    "reminderLeadMinutes": {
      "minimum": 1,
      "type": "integer"
    },
    "venueId": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "changedBy",
    "expiresAt",
    "holdId",
    "holdReference",
    "reminderLeadMinutes",
    "venueId"
  ],
  "type": "object"
}
