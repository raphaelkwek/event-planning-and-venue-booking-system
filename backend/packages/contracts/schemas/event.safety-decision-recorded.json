{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "coordinatorId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decidedAt": {
      "format": "date-time",
      "type": "string"
    },
    "decidedBy": {
      "format": "uuid",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "REJECT"
      ],
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "flaggedBookingReferences": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "flaggedEquipment": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ownerId": {
      "format": "uuid",
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "coordinatorId",
    "decidedAt",
    "decidedBy",
    "decision",
    "eventId",
    "eventName",
    "eventReference",
    "flaggedBookingReferences",
    "flaggedEquipment",
    "ownerId",
    "reason"
  ],
  "type": "object"
}
