{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bookingRequestId": {
      "format": "uuid",
      "type": "string"
    },
    "endsAt": {
      "format": "date-time",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "reference": {
      "pattern": "^BKR-\\d{6}$",
      "type": "string"
    },
    "requestedAt": {
      "format": "date-time",
      "type": "string"
    },
    "requestedBy": {
      "format": "uuid",
      "type": "string"
    },
    "staffIds": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "startsAt": {
      "format": "date-time",
      "type": "string"
    },
    "venueId": {
      "format": "uuid",
      "type": "string"
    },
    "venueName": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "bookingRequestId",
    "endsAt",
    "eventId",
    "eventName",
    "eventReference",
    "reference",
    "requestedAt",
    "requestedBy",
    "staffIds",
    "startsAt",
    "venueId",
    "venueName"
  ],
  "type": "object"
}
