{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assignedCoordinatorId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "changedAt": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "highDemand": {
      "default": false,
      "type": "boolean"
    },
    "ownerId": {
      "format": "uuid",
      "type": "string"
    },
    "proposedEndAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposedStartAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "registrationClosesAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "registrationOpensAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "registrationRequired": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "UNDER_REVIEW",
        "AWAITING_CLARIFICATION",
        "APPROVED",
        "PLANNING",
        "SAFETY_REVIEW",
        "CONFIRMED",
        "COMPLETED",
        "CANCELLED",
        "REJECTED"
      ],
      "type": "string"
    },
    "withdrawalDeadlineAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "changedAt",
    "description",
    "eventId",
    "eventName",
    "eventReference",
    "ownerId",
    "proposedEndAt",
    "proposedStartAt",
    "registrationClosesAt",
    "registrationOpensAt",
    "registrationRequired",
    "status",
    "withdrawalDeadlineAt"
  ],
  "type": "object"
}
