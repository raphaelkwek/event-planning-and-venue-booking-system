{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bookingId": {
      "format": "uuid",
      "type": "string"
    },
    "bookingRequestId": {
      "format": "uuid",
      "type": "string"
    },
    "coordinatorId": {
      "format": "uuid",
      "type": "string"
    },
    "decidedAt": {
      "format": "date-time",
      "type": "string"
    },
    "decidedBy": {
      "format": "uuid",
      "type": "string"
    },
    "endsAt": {
      "format": "date-time",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "layout": {
      "minLength": 1,
      "type": "string"
    },
    "layoutCapacity": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "ownerId": {
      "format": "uuid",
      "type": "string"
    },
    "reference": {
      "pattern": "^BKR-\\d{6}$",
      "type": "string"
    },
    "replacedBookingId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "startsAt": {
      "format": "date-time",
      "type": "string"
    },
    "venueId": {
      "format": "uuid",
      "type": "string"
    },
    "venueLocation": {
      "minLength": 1,
      "type": "string"
    },
    "venueName": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "bookingId",
    "bookingRequestId",
    "coordinatorId",
    "decidedAt",
    "decidedBy",
    "endsAt",
    "eventId",
    "eventName",
    "eventReference",
    "ownerId",
    "reference",
    "replacedBookingId",
    "startsAt",
    "venueId",
    "venueName"
  ],
  "type": "object"
}
