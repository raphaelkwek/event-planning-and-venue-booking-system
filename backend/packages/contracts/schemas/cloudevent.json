{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "type": "string"
    },
    "correlationid": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "additionalProperties": {},
      "type": "object"
    },
    "datacontenttype": {
      "const": "application/json",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "source": {
      "pattern": "^\\/connectsphere\\/[a-z][a-z0-9-]*(\\/[a-z][a-z0-9-]*)?$",
      "type": "string"
    },
    "specversion": {
      "const": "1.0",
      "type": "string"
    },
    "subject": {
      "format": "uuid",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "type": "string"
    },
    "traceparent": {
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "actor",
    "data",
    "datacontenttype",
    "id",
    "source",
    "specversion",
    "subject",
    "time",
    "traceparent",
    "type"
  ],
  "type": "object"
}
