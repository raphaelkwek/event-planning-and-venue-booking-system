{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "equipmentTypeName": {
      "minLength": 1,
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "eventName": {
      "minLength": 1,
      "type": "string"
    },
    "eventReference": {
      "minLength": 1,
      "type": "string"
    },
    "lineId": {
      "format": "uuid",
      "type": "string"
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "requestedAt": {
      "format": "date-time",
      "type": "string"
    },
    "requestedBy": {
      "format": "uuid",
      "type": "string"
    },
    "requiredFrom": {
      "format": "date-time",
      "type": "string"
    },
    "requiredTo": {
      "format": "date-time",
      "type": "string"
    },
    "technicalSupportIds": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "equipmentTypeName",
    "eventId",
    "eventName",
    "eventReference",
    "lineId",
    "quantity",
    "requestedAt",
    "requestedBy",
    "requiredFrom",
    "requiredTo",
    "technicalSupportIds"
  ],
  "type": "object"
}
