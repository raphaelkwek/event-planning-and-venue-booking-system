{
  "name": "@connectsphere/planning-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "worker": "tsx watch --env-file=../../../.env src/temporal/worker.ts",
    "start:worker": "node dist/temporal/worker.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:mutation": "stryker run",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.mjs && tsx scripts/check-schema-boundaries.ts"
  },
  "dependencies": {
    "@connectsphere/contracts": "*",
    "@connectsphere/kafka": "*",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "jose": "^5.6.3",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@temporalio/common": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.1",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.4.5",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "yaml": "^2.9.1"
  }
}
