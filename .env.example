# Shared
NODE_ENV=development
LOG_LEVEL=info

# Kafka — one hosted cluster shared by the team (ADR-0003). No broker runs on
# anyone's laptop. Copy these from the provider's console. Hosted clusters
# require TLS and SASL authentication; the mechanism is one of plain,
# scram-sha-256 or scram-sha-512, whichever the provider issues credentials for.
KAFKA_BROKERS=replace-with-bootstrap-server:9092
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SASL_USERNAME=replace-with-kafka-username-or-api-key
KAFKA_SASL_PASSWORD=replace-with-kafka-password-or-api-secret

# Supabase (shared by every service) — the team's hosted project.
# DATABASE_URL: dashboard → Connect → Transaction pooler (port 6543). That
# pooler does not support prepared statements, so connect with prepare: false.
DATABASE_URL=replace-with-transaction-pooler-connection-string
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key-from-project-settings
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-project-settings
SUPABASE_JWKS_URL=https://replace-with-project-ref.supabase.co/auth/v1/.well-known/jwks.json
INTERNAL_TOKEN_SECRET=replace-with-a-long-random-string

# planning-core — the one staff-facing deployable (ADR-0004): the identity,
# event, venue, equipment and change modules in one process. Older .env files
# may still set PORT, SERVICE_NAME, DATABASE_SCHEMA, EVENT_PORT,
# EVENT_DATABASE_SCHEMA and IDENTITY_BASE_URL for the two services it replaced;
# nothing reads them any more, so they can be deleted.
PLANNING_CORE_PORT=8090

# Event module
# The `producer` written into event message envelopes. Unchanged by the merge.
EVENT_SERVICE_NAME=event-service
# TODO(E1/E2): the eligible coordinator pool is configuration while automatic
# assignment and nominee eligibility are stubbed. Comma-separated
# identity.users.id values. Replace with a lookup of active EVENT_COORDINATOR
# users through the identity module when E1/E2 are built for real.
# Both seeded coordinators (tests/README.md) are listed so the round-robin
# (E1) and reassignment (E2) test cases have a second coordinator to use.
EVENT_COORDINATOR_POOL=00000000-0000-0000-0000-000000000002,00000000-0000-0000-0000-000000000008
