# Shared
NODE_ENV=development
LOG_LEVEL=info
KAFKA_BROKERS=localhost:9092

# Supabase (shared by every service)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
INTERNAL_TOKEN_SECRET=replace-with-a-long-random-string

# Identity service
PORT=8081
SERVICE_NAME=identity-service
DATABASE_SCHEMA=identity

# Event service
# EVENT_PORT takes precedence over PORT so both services can run from one
# local .env; in Docker each container gets its own PORT.
EVENT_PORT=8082
EVENT_SERVICE_NAME=event-service
EVENT_DATABASE_SCHEMA=event
# Where the Event Service resolves the caller's role and access scope (A3).
IDENTITY_BASE_URL=http://127.0.0.1:8081
# TODO(E1): the eligible coordinator pool is configuration while automatic
# assignment is stubbed. Comma-separated identity.users.id values. Replace with
# a live Identity lookup of active EVENT_COORDINATOR users when E1 is built.
EVENT_COORDINATOR_POOL=00000000-0000-0000-0000-000000000002
